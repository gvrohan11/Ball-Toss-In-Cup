# Copy to .env (never commit .env). Values come from the Viam app:
# sfhack11 -> CONNECT tab -> Python -> turn on "Include API key"
VIAM_ADDRESS=sfhack11-main.xxxxxxxxxx.viam.cloud
# scripts/inspect_ball.py currently uses this name for the same hostname:
VIAM_MACHINE_ADDRESS=sfhack11-main.xxxxxxxxxx.viam.cloud
VIAM_API_KEY=
VIAM_API_KEY_ID=

# MongoDB Atlas (event cluster) - used by logger.py
MONGODB_URI=
